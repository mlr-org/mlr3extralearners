\name{mlr_learners_regr.gpboost}
\alias{mlr_learners_regr.gpboost}
\alias{LearnerRegrGPBoost}
\title{Regression GPBoost Learner}
\description{
Tree-boosting combined with Gaussian process and grouped random effects models.
Calls \code{gpboost::gpb.train()} from \CRANpkg{gpboost}.

The random effects model is specified with the custom parameters \code{group_data_cols} and \code{gp_coords_cols}.
If neither is set, a plain gradient boosting model is fitted.
The boosting parameters are documented \href{https://gpboost.readthedocs.io/en/latest/Parameters.html}{here}
and in the documentation of \code{gpboost::gpb.train()}.
The parameters of the random effects model are documented in \code{gpboost::GPModel()}.
}
\section{Custom mlr3 parameters}{

\itemize{
\item \code{group_data_cols}: Names of features that define grouped random effects, one random intercept per column.
The columns are passed to \code{gpboost::GPModel()} as \code{group_data} and are excluded from the tree features.
\item \code{gp_coords_cols}: Names of numeric features that are the coordinates of a Gaussian process.
The columns are passed to \code{gpboost::GPModel()} as \code{gp_coords} and are excluded from the tree features.
\item \code{seed} is passed to the boosting algorithm and to \code{gpboost::GPModel()}.
\item \code{nrounds} sets the number of boosting iterations.
The alias \code{num_iterations} is not available.
\item Observation weights are passed to \code{gpboost::GPModel()} if a random effects model is used
and to \code{gpboost::gpb.Dataset()} otherwise.
\item The predict type \code{"se"} returns the square root of the predictive variance
and requires a random effects model.
}
}

\section{Initial parameter values}{

\itemize{
\item \code{num_threads} is initialized to 1 to avoid conflicts with parallelization via \CRANpkg{future}.
\item \code{verbose} is initialized to -1 to suppress the output of GPBoost.
}
}

